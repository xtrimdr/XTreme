<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XtremeDaw.App"
             xmlns:controls="using:XtremeDaw.App.Controls"
             x:Class="XtremeDaw.App.Dialogs.ComponentsDialog"
             AutomationProperties.Name="{loc:T component.title}"
             Background="{StaticResource Scrim}" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">

  <!-- same frame as UnsavedDialog: shown at startup when something is missing, and from what needs it -->
  <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <StackPanel Margin="24,22,24,20" Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="icon" Text="&#xE896;" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        <TextBlock Classes="dialog-title" Text="{loc:T component.title}" />
      </StackPanel>
      <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="18" Text="{loc:T component.body}" />
      <controls:ComponentList x:Name="List" OnlyMissing="True" />
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="RecheckButton" Classes="btn" Content="{loc:T component.recheck}" ToolTip.Tip="{loc:T component.recheck.tip}" />
        <Button Grid.Column="2" x:Name="SkipButton" Classes="btn" Content="{loc:T component.skip}" ToolTip.Tip="{loc:T component.skip.tip}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
