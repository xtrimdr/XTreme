<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XtremeDaw.App"
             x:Class="XtremeDaw.App.Dialogs.SettingsDialog"
             AutomationProperties.Name="{loc:T settings.title}"
             KeyboardNavigation.TabNavigation="Cycle" Focusable="True">

  <!-- Port of SettingsDialog from the web app's SettingsDialog.tsx; "Atajos de teclado" and "Idioma" are native only -->
  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Height" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <!-- a floating panel without a scrim (#184): the window behind stays usable; the header moves it, the corner grip resizes it -->
  <Border x:Name="Panel" Width="768" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top"
          Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Panel>
    <Grid RowDefinitions="Auto,*">
      <Border x:Name="Header" Background="Transparent" Cursor="SizeAll" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10,12,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="dialog-title" Text="{loc:T settings.title}" />
          <Button Grid.Column="1" x:Name="CloseButton" Cursor="Arrow" Classes="act close" ToolTip.Tip="{loc:T common.close}" AutomationProperties.Name="{loc:T common.close}">
            <TextBlock Classes="icon" Text="&#xE711;" FontSize="13" />
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="208,*">
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="8">
          <StackPanel Spacing="2">
            <!-- searches every page (#302): SettingsDialog.Search.cs -->
            <Panel Margin="0,0,0,6">
              <TextBox x:Name="SearchBox" Classes="field" Watermark="{loc:T settings.search}" AutomationProperties.Name="{loc:T settings.search}" Padding="32,0,28,0" />
              <TextBlock Classes="icon" Text="&#xE721;" FontSize="13" Foreground="{StaticResource Faint}" Margin="11,0,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Button x:Name="SearchClear" Classes="act" Cursor="Arrow" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                      ToolTip.Tip="{loc:T settings.search.clear}" AutomationProperties.Name="{loc:T settings.search.clear}">
                <TextBlock Classes="icon" Text="&#xE711;" FontSize="10" />
              </Button>
            </Panel>
            <Button x:Name="AudioTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE8D6;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.audio}" /></StackPanel>
            </Button>
            <Button x:Name="MidiTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE703;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.midi}" /></StackPanel>
            </Button>
            <Button x:Name="CameraTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE722;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.camera}" /></StackPanel>
            </Button>
            <Button x:Name="SyncTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE916;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.sync}" /></StackPanel>
            </Button>
            <Button x:Name="SaveTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE74E;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.save}" /></StackPanel>
            </Button>
            <Button x:Name="FilesTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE8E5;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.files}" /></StackPanel>
            </Button>
            <Button x:Name="ViewTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE890;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.view}" /></StackPanel>
            </Button>
            <Button x:Name="PluginsTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xEA86;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.plugins}" /></StackPanel>
            </Button>
            <Button x:Name="ComponentsTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE896;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.components}" /></StackPanel>
            </Button>
            <Button x:Name="ShortcutsTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE765;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.shortcuts}" /></StackPanel>
            </Button>
            <Button x:Name="LanguageTab" Classes="nav">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE774;" FontSize="15" /><TextBlock Text="{loc:T settings.tab.language}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1" x:Name="Body" HorizontalScrollBarVisibility="Disabled" />
      </Grid>
    </Grid>
    <Border x:Name="Grip" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner">
      <Path Data="M14,4 L4,14 M14,9 L9,14" Stroke="{StaticResource Faint}" StrokeThickness="1.2" />
    </Border>
    </Panel>
  </Border>
</UserControl>
