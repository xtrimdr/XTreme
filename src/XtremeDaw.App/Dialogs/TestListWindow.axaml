<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:XtremeDaw.App"
        x:Class="XtremeDaw.App.Dialogs.TestListWindow"
        Title="{loc:T test.list.title}" Width="480" Height="600" MinWidth="340" MinHeight="260"
        ShowInTaskbar="True" ShowActivated="False" WindowStartupLocation="Manual"
        Background="{StaticResource App}" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="36">

  <Grid RowDefinitions="36,Auto,*,Auto">
    <Border x:Name="Header" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <TextBlock Text="{loc:T test.list.title}" FontSize="12.5" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Border>

    <Border Grid.Row="1" Classes="seg" Margin="10,10,10,0" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="PendingTab" Classes="seg" />
        <ToggleButton x:Name="NotedTab" Classes="seg" />
        <ToggleButton x:Name="FixTab" Classes="seg" />
        <ToggleButton x:Name="DoneTab" Classes="seg" />
      </StackPanel>
    </Border>

    <!-- The right margin keeps the scroll bar off the window's resize border, which takes the outer ~8 px (frame + padding). -->
    <ScrollViewer Grid.Row="2" Margin="0,0,8,0">
      <StackPanel x:Name="Rows" Margin="10,10,2,10" Spacing="8" />
    </ScrollViewer>

    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ErrorText" Classes="notice" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button x:Name="ClearButton" Grid.Column="1" Classes="btn sm" Content="{loc:T test.list.clear}" />
      </Grid>
    </Border>
  </Grid>
</Window>
