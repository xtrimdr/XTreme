<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:XtremeDaw.App"
        x:Class="XtremeDaw.App.Dialogs.TestListWindow"
        Title="{loc:T test.list.title}" Width="540" Height="640" MinWidth="340" MinHeight="260"
        ShowInTaskbar="True" ShowActivated="False" WindowStartupLocation="Manual"
        Background="{StaticResource App}" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="44">

  <Grid x:Name="Shell" RowDefinitions="44,*,Auto,Auto">
    <!-- The accent line under the title gives the window its own face next to the app. -->
    <Border x:Name="Header" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent40}" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True">
          <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource AccentSoft}">
            <TextBlock Classes="icon" Text="&#xE9D5;" FontSize="13" Foreground="{StaticResource Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{loc:T test.list.title}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border x:Name="BuildBadge" CornerRadius="5" Padding="6,1" Background="{StaticResource Hover}" VerticalAlignment="Center" IsVisible="False">
            <TextBlock x:Name="BuildText" Classes="dim mono" FontSize="11" />
          </Border>
        </StackPanel>
        <!-- The window's own buttons, left of the system's (minimize, maximize, close take ~138 px). -->
        <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0,142,0" VerticalAlignment="Center">
          <!-- The bell (asked by the user, #260): how many tickets are "Nuevo"; its menu lists them. -->
          <Button x:Name="BellButton" Classes="ghost" AutomationProperties.Name="{loc:T test.list.bell}">
            <Grid>
              <TextBlock Classes="icon" Text="&#xEA8F;" FontSize="13" />
              <Border x:Name="BellBadge" IsVisible="False" Background="{StaticResource Accent}" CornerRadius="7" MinWidth="14" Height="14"
                      Padding="3,0" Margin="0,-7,-9,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="BellCount" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource App}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
          <Button x:Name="NewRequestButton" Classes="ghost" AutomationProperties.Name="{loc:T test.list.request.new}">
            <TextBlock Classes="icon" Text="&#xE710;" FontSize="13" />
          </Button>
          <Button x:Name="OpenAppButton" Classes="ghost" IsVisible="False" AutomationProperties.Name="{loc:T test.list.openapp}">
            <TextBlock Classes="icon" Text="&#xE768;" FontSize="13" />
          </Button>
          <!-- The Agentes window (#273): the map of the open sessions and their files, and their conversation; how many are open. -->
          <Button x:Name="AgentsButton" Classes="ghost" IsVisible="False" AutomationProperties.Name="{loc:T test.list.agents.title}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="icon" Text="&#xE716;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock x:Name="AgentsCount" Classes="mono" FontSize="11" VerticalAlignment="Center" IsVisible="False" />
            </StackPanel>
          </Button>
          <Button x:Name="ClaudeButton" Classes="ghost" IsVisible="False" AutomationProperties.Name="{loc:T test.list.claude}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="icon" Text="&#xE99A;" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
              <TextBlock Classes="icon" Text="&#xE70D;" FontSize="8" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The bench's own text size (asked by the user, #143: the slider by Historial), over the app's: header and footer stay. -->
    <LayoutTransformControl x:Name="Zoomed" Grid.Row="1">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
    <!-- No tabs (asked by the user, #125: all of it in one vertical list); the search filters the whole list. -->
    <Grid Grid.Row="1" Margin="10,10,18,0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
      <!-- What the list shows (asked by the user, #249): Pendiente, En curso, Para probar, Terminado or Todo, each with its count. -->
      <Border x:Name="ViewBar" Grid.Row="1" Grid.ColumnSpan="2" Classes="seg" Margin="0,8,0,0">
        <UniformGrid x:Name="ViewRow" Rows="1" />
      </Border>
      <!-- Folds every topic, or opens them all when they are all folded (asked by the user, #126). -->
      <Button x:Name="FoldAllButton" Grid.Column="1" Classes="chip" Width="30" Height="30" MinHeight="30" Padding="0" Margin="6,0,0,0"
              VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
        <TextBlock x:Name="FoldAllIcon" Classes="icon" Text="&#xE971;" FontSize="11" />
      </Button>
      <TextBox x:Name="SearchBox" Classes="field" Height="30" MinHeight="30"
               VerticalAlignment="Top" VerticalContentAlignment="Center" Watermark="{loc:T test.list.search}">
        <TextBox.InnerLeftContent>
          <TextBlock Classes="icon" Text="&#xE721;" FontSize="11" Foreground="{StaticResource Faint}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </Grid>

    <!-- Outside the rows, so a list that changes while typing never takes the box away. A request, or a new skill. -->
    <Border x:Name="Composer" Grid.Row="2" IsVisible="False" Margin="10,10,18,0" Background="{StaticResource Raised}"
            BorderBrush="{StaticResource Accent40}" BorderThickness="1" CornerRadius="8" Padding="12,10">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="ComposerIcon" Classes="icon" Text="&#xE710;" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
          <TextBlock x:Name="ComposerTitle" Classes="label" Foreground="{StaticResource Accent}" Text="{loc:T test.list.request.new}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox x:Name="RequestBox" Classes="field note" Watermark="{loc:T test.list.request.hint}" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="64" MaxHeight="180" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CancelEditButton" Classes="btn sm" Content="{loc:T common.cancel}" IsVisible="False" />
          <Button x:Name="AddButton" Classes="btn sm primary" Content="{loc:T test.list.request.add}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The right margin keeps the scroll bar off the window's resize border, which takes the outer ~8 px (frame + padding). -->
    <!-- The open ticket's back link and "⋯", outside the scroll: a long conversation never hides the way back (#175). -->
    <Decorator x:Name="TicketBar" Grid.Row="3" Margin="10,10,18,0" IsVisible="False" />

    <ScrollViewer x:Name="Scroller" Grid.Row="4" Margin="0,0,8,0">
      <StackPanel x:Name="Rows" Margin="10,10,2,10" Spacing="8" />
    </ScrollViewer>
    </Grid>
    </LayoutTransformControl>

    <!-- Agentes, big and always at hand (asked by the user, #278): how many sessions are open and how many wait for you. -->
    <Button x:Name="AgentsBigButton" Grid.Row="2" Classes="btn primary" IsVisible="False" Height="48" Margin="10,8,10,8"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            AutomationProperties.Name="{loc:T test.list.agents.title}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="icon" Text="&#xE716;" FontSize="18" VerticalAlignment="Center" />
        <TextBlock Text="{loc:T test.list.agents.title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="AgentsBigText" Classes="mono" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <WrapPanel x:Name="Totals" VerticalAlignment="Center" ItemSpacing="12" />
        <TextBlock x:Name="ErrorText" Grid.Column="1" Classes="notice" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" />
        <StackPanel x:Name="ZoomPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock Classes="icon" Text="&#xE8D2;" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
          <Slider x:Name="ZoomSlider" Width="80" Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1"
                  TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          <TextBlock x:Name="ZoomText" Classes="dim mono" FontSize="11" MinWidth="34" VerticalAlignment="Center" />
        </StackPanel>
        <ToggleButton x:Name="HistoryButton" Grid.Column="3" Classes="chip" MinHeight="26" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xE81C;" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="{loc:T test.list.history}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Button x:Name="ClearButton" Grid.Column="4" Classes="btn sm" Content="{loc:T test.list.clear}" />
      </Grid>
    </Border>
  </Grid>
</Window>
