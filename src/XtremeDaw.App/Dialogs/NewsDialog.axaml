<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XtremeDaw.App"
             x:Class="XtremeDaw.App.Dialogs.NewsDialog"
             AutomationProperties.Name="{loc:T news.title}"
             Background="{StaticResource Scrim}" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">

  <!-- same frame as SettingsDialog -->

  <Border Margin="32" Width="640" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10,12,10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="icon" Text="&#xE789;" FontSize="15" Foreground="{StaticResource Accent}" />
            <TextBlock Classes="dialog-title" Text="{loc:T news.title}" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="CloseButton" Classes="act close" ToolTip.Tip="{loc:T common.close}" AutomationProperties.Name="{loc:T common.close}">
            <TextBlock Classes="icon" Text="&#xE711;" FontSize="13" />
          </Button>
        </Grid>
      </Border>
      <WrapPanel Grid.Row="1" x:Name="Versions" Margin="20,12,12,4" />
      <ScrollViewer Grid.Row="2" x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="List" Spacing="8" Margin="20,8,20,12" />
      </ScrollViewer>
      <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
        <Button x:Name="OkButton" Classes="btn primary" Padding="16,0" HorizontalAlignment="Right" Content="{loc:T news.ok}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
