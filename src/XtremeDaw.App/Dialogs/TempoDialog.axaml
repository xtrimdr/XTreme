<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XtremeDaw.App"
             x:Class="XtremeDaw.App.Dialogs.TempoDialog"
             AutomationProperties.Name="{loc:T tempo.ask.title}"
             Background="#B3000000" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">

  <!-- same frame as UnsavedDialog: asked when the tempo changes with audio on the timeline -->
  <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <StackPanel Margin="24,22,24,20" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="icon" Text="&#xE916;" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        <TextBlock Text="{loc:T tempo.ask.title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="Body" Classes="dim" TextWrapping="Wrap" LineHeight="18" />
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button x:Name="CancelButton" Classes="btn" Content="{loc:T transport.count.cancel}" />
        <Button Grid.Column="2" x:Name="GridButton" Classes="btn" Margin="8,0,0,0" Content="{loc:T tempo.ask.grid}" ToolTip.Tip="{loc:T tempo.ask.grid.tip}" />
        <Button Grid.Column="3" x:Name="StretchButton" Classes="btn primary" Margin="8,0,0,0" Padding="16,0" Content="{loc:T tempo.ask.stretch}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
