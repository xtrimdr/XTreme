<Project Sdk="Microsoft.NET.Sdk">

  <!-- xtbench.exe, XT-WorkBench: the Banco de pruebas as a program of its own (asked by the user, #142: a build of
       XTreme must not close it). It takes the window, its styles and texts from XtremeDaw.App as linked files, never
       XTreme.dll, so its build only changes when they do; tools\probar.ps1 puts it in pruebas\banco\ only then. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>xtbench</AssemblyName>
    <RootNamespace>XtremeDaw.App</RootNamespace>
    <Product>XT-WorkBench</Product>
    <AssemblyTitle>XT-WorkBench</AssemblyTitle>
    <ApplicationIcon>..\XtremeDaw.App\Assets\XTreme.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- only Windows' native libraries (Skia, HarfBuzz), not every OS's -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Audio's models, FFmpeg and plugin hosts reach this project through Projects: they are not the bench's (hundreds of MB).
       What stays is its own (the exe) and what it takes from App (the fonts' licenses). -->
  <Target Name="DropAudioContent" AfterTargets="GetCopyToOutputDirectoryItems">
    <PropertyGroup>
      <_BenchApp>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\XtremeDaw.App\'))</_BenchApp>
      <_BenchOwn>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</_BenchOwn>
    </PropertyGroup>
    <ItemGroup>
      <_BenchCopy Include="@(_SourceItemsToCopyToOutputDirectory)" Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_BenchApp)')) Or $([System.String]::Copy('%(FullPath)').StartsWith('$(_BenchOwn)'))" />
      <_BenchCopyAlways Include="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_BenchApp)')) Or $([System.String]::Copy('%(FullPath)').StartsWith('$(_BenchOwn)'))" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" />
      <_SourceItemsToCopyToOutputDirectory Include="@(_BenchCopy)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Include="@(_BenchCopyAlways)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- comes with Audio; the bench never runs a model, so its native libraries (tens of MB) stay out -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" ExcludeAssets="native;runtime;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XtremeDaw.Projects\XtremeDaw.Projects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\XtremeDaw.App\Bench.cs" Link="App\Bench.cs" />
    <Compile Include="..\XtremeDaw.App\Loc.cs" Link="App\Loc.cs" />
    <Compile Include="..\XtremeDaw.App\TestBuild.cs" Link="App\TestBuild.cs" />
    <Compile Include="..\XtremeDaw.App\UiTheme.cs" Link="App\UiTheme.cs" />
    <Compile Include="..\XtremeDaw.App\AgentLauncher.cs" Link="App\AgentLauncher.cs" />
    <Compile Include="..\XtremeDaw.App\LockLight.cs" Link="App\LockLight.cs" />
    <Compile Include="..\XtremeDaw.App\AgentAlert.cs" Link="App\AgentAlert.cs" />
    <Compile Include="..\XtremeDaw.App\AgentTranscript.cs" Link="App\AgentTranscript.cs" />
    <Compile Include="..\XtremeDaw.App\Terminal\*.cs" Link="App\Terminal\%(Filename)%(Extension)" />
    <Compile Include="..\XtremeDaw.App\Dialogs\TestListWindow.Consoles.cs" Link="App\Dialogs\TestListWindow.Consoles.cs" DependentUpon="TestListWindow.axaml" />
    <Compile Include="..\XtremeDaw.App\Controls\Palette.cs" Link="App\Controls\Palette.cs" />
    <Compile Include="..\XtremeDaw.App\Controls\UiFonts.cs" Link="App\Controls\UiFonts.cs" />
    <Compile Include="..\XtremeDaw.App\Controls\ThemePicker.cs" Link="App\Controls\ThemePicker.cs" />
    <Compile Include="..\XtremeDaw.App\Controls\ToastHost.cs" Link="App\Controls\ToastHost.cs" />
    <Compile Include="..\XtremeDaw.App\Dialogs\TestListWindow.axaml.cs" Link="App\Dialogs\TestListWindow.axaml.cs" DependentUpon="TestListWindow.axaml" />
    <Compile Include="..\XtremeDaw.App\Dialogs\TestListWindow.Images.cs" Link="App\Dialogs\TestListWindow.Images.cs" DependentUpon="TestListWindow.axaml" />
    <Compile Include="..\XtremeDaw.App\Dialogs\TestListWindow.Agents.cs" Link="App\Dialogs\TestListWindow.Agents.cs" DependentUpon="TestListWindow.axaml" />
    <Compile Include="..\XtremeDaw.App\Dialogs\TestListWindow.AgentMap.cs" Link="App\Dialogs\TestListWindow.AgentMap.cs" />
    <AvaloniaXaml Include="..\XtremeDaw.App\Dialogs\TestListWindow.axaml" Link="App\Dialogs\TestListWindow.axaml" />
    <!-- the app's own tokens and styles: x:Class App is this project's BenchApp.cs -->
    <AvaloniaXaml Include="..\XtremeDaw.App\App.axaml" Link="App\App.axaml" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\XtremeDaw.App\Assets\XTreme.ico" Link="Assets\XTreme.ico" />
    <AvaloniaResource Include="..\XtremeDaw.App\Assets\Lang\*.json" Link="Assets\Lang\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\XtremeDaw.App\Assets\Lang\Bench\*.json" Link="Assets\Lang\Bench\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\XtremeDaw.App\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <None Include="..\XtremeDaw.App\Assets\Fonts\*-LICENSE.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
