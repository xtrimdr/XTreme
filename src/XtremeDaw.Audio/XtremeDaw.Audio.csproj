<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Optimized in Debug too (asked by the user): the test copies are Debug builds, and unoptimized DSP (Vector<float>
         above all) costs several times more, so the DSP meter didn't show what the installer does. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
  </ItemGroup>

  <!-- FFmpeg 9 shared DLLs for the in-process preview decoder (NativeVideoSource): lib/ffmpeg is kept out of git
       (see DETALLES.md). Without them the preview falls back to ffmpeg.exe through a pipe. -->
  <ItemGroup>
    <None Include="..\..\lib\ffmpeg\*.dll;..\..\lib\ffmpeg\*.txt" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Basic Pitch's model (Spotify, Apache 2.0) for "Extraer MIDI" (AudioToMidi): lib/basic-pitch is kept out of git
       (tools/get-basic-pitch.ps1). Without it the extractor says it is missing and the rest works. -->
  <ItemGroup>
    <None Include="..\..\lib\basic-pitch\*.onnx;..\..\lib\basic-pitch\*.txt" Link="basic-pitch\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The General MIDI bank (GeneralUser GS, free to use and redistribute) for the native GM instrument (GmSynth):
       lib/gm is kept out of git (tools/get-gm.ps1) and goes in the installer. Without it a GM track says it is missing. -->
  <ItemGroup>
    <None Include="..\..\lib\gm\*.sf2;..\..\lib\gm\*.txt" Link="gm\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- DirectML's own DLL next to the program: its package doesn't copy it for .NET, and then the one of each Windows runs,
       whatever its version. StemSeparator checks a graphics card against the CPU either way. -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.ai.directml\1.15.4\bin\x64-win\DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)microsoft.ai.directml\1.15.4\bin\x64-win\DirectML.dll')" />
  </ItemGroup>

  <!-- Demucs' models for "Separar en stems" (StemSeparator): lib/demucs is kept out of git (tools/get-demucs.ps1) and out
       of the installer, since the license of the weights is not clear. Without them that option says they are missing. -->
  <ItemGroup>
    <None Include="..\..\lib\demucs-graphs\*" Link="demucs-graphs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\lib\demucs\*.onnx" Link="demucs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- xtvsthost.exe and xtvsthost32.exe, the plugin host (src/XtremeDaw.VstHost, C++) for 64 and 32 bits: built here with
       Visual Studio's MSBuild when the C++ tools, the Windows SDK and lib/vst3sdk (tools/get-vst3sdk.ps1) are there, and
       copied next to the app and xtlab. Without them the build goes on and the app plays MIDI tracks with the test tone only. -->
  <PropertyGroup>
    <XtVstHostDir>$(MSBuildThisFileDirectory)..\XtremeDaw.VstHost\</XtVstHostDir>
    <XtVstHostExe>$(XtVstHostDir)bin\Release\xtvsthost.exe</XtVstHostExe>
    <XtVstHost32Exe>$(XtVstHostDir)bin\Release\xtvsthost32.exe</XtVstHost32Exe>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(XtVstHostExe)" Link="xtvsthost.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(XtVstHostExe)')" />
    <None Include="$(XtVstHost32Exe)" Link="xtvsthost32.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(XtVstHost32Exe)')" />
  </ItemGroup>
  <Target Name="BuildVstHost" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And Exists('$(MSBuildThisFileDirectory)..\..\lib\vst3sdk\pluginterfaces\base') And Exists('$(MSBuildProgramFiles32)\Windows Kits\10\Include')">
    <Exec Command="&quot;$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find MSBuild\**\Bin\amd64\MSBuild.exe" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true" Condition="Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe')">
      <Output TaskParameter="ConsoleOutput" PropertyName="XtVsMsBuild" />
    </Exec>
    <Message Importance="normal" Text="Sin MSBuild de Visual Studio con C++: no compilo xtvsthost.exe (las pistas MIDI suenan con el tono de prueba)." Condition="'$(XtVsMsBuild)' == '' Or !Exists('$(XtVsMsBuild)')" />
    <Exec Command="&quot;$(XtVsMsBuild)&quot; &quot;$(XtVstHostDir)XtremeDaw.VstHost.vcxproj&quot; -p:Configuration=Release -p:Platform=x64 -nologo -v:quiet -m" Condition="'$(XtVsMsBuild)' != '' And Exists('$(XtVsMsBuild)')" />
    <Exec Command="&quot;$(XtVsMsBuild)&quot; &quot;$(XtVstHostDir)XtremeDaw.VstHost.vcxproj&quot; -p:Configuration=Release -p:Platform=Win32 -nologo -v:quiet -m" Condition="'$(XtVsMsBuild)' != '' And Exists('$(XtVsMsBuild)')" />
    <ItemGroup Condition="Exists('$(XtVstHostExe)')">
      <None Remove="$(XtVstHostExe)" />
      <None Include="$(XtVstHostExe)" Link="xtvsthost.exe" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(XtVstHost32Exe)')">
      <None Remove="$(XtVstHost32Exe)" />
      <None Include="$(XtVstHost32Exe)" Link="xtvsthost32.exe" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
